# Local agent
TOOLMGR_PORT=7788
TOOLMGR_HOST=127.0.0.1
# Leave empty to use OS default:
#   Windows: %LOCALAPPDATA%\ToolMgr
#   macOS:   ~/Library/Application Support/ToolMgr
# SQLite file: <dataDir>/aitoolmgr.sqlite
TOOLMGR_DATA_DIR=
TOOLMGR_SIMULATOR=true
TOOLMGR_MACHINE_NAME=
TOOLMGR_PAIRING_TOKEN=change-me
TOOLMGR_HUB_URL=
TOOLMGR_IS_HUB=true

# Feishu custom bot
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=

# Optional tool credentials
CURSOR_API_KEY=
COZE_PAT=
COZE_BOT_ID=
COZE_BASE_URL=https://api.coze.cn
